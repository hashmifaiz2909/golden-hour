# Golden Hour Environment Configuration

# Backend API
PORT=5050
NODE_ENV=development
JWT_SECRET=golden-hour-production-emergency-jwt-secret-key-2026

# Python ML Microservice
ML_SERVICE_URL=http://localhost:5001

# Email Service (Resend Integration)
# Add your secret API key from https://resend.com/api-keys
RESEND_API_KEY=
# During sandbox testing (before domain verification), set your Resend signup email here
RESEND_ACCOUNT_EMAIL=
APP_BASE_URL=http://localhost:3000

# Emergency Voice Calls & WhatsApp Notifications (Twilio)
# Set MOCK_NOTIFICATIONS=false to enable live Twilio Voice and WhatsApp dispatch
MOCK_NOTIFICATIONS=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_PHONE=+1234567890
# Twilio WhatsApp sandbox number (default is whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
